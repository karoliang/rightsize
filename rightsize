#!/bin/bash
# PATH entry point. Python resolves only named, explicitly scoped credentials.
# Preserve the caller's working directory and the command's exit code.
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
ROOT="$(cd "$(dirname "$SELF")" && pwd)"

exec python3 "$ROOT/rightsize.py" "$@"
