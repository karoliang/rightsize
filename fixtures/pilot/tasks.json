    {
      "id": "implementation-optional-context",
      "tier": "implementation",
      "task": "Mandatory nonnegative byte sizes must all fit or return null. Otherwise return selected optional indices, scanning in order and greedily including each nonnegative optional size that fits the remaining integer budget. Skip oversized optional entries, continuing the scan.",
      "initial_source": "def solve(mandatory, optional, budget):\n    return []\n",
      "reference_source": "def solve(mandatory, optional, budget):\n    remaining=budget-sum(mandatory)\n    if remaining<0:\n        return None\n    selected=[]\n    for index,size in enumerate(optional):\n        if size<=remaining:\n            selected.append(index)\n            remaining-=size\n    return selected\n",
      "cases": [
        {
          "args": [
            [
              4,
              3
            ],
            [
              5,
              2,
              1
            ],
            10
          ],
          "expected": [
            1,
            2
          ]
        },
        {
          "args": [
