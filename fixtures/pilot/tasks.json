      "initial_source": "def solve(buckets):\n    return buckets\n",
      "reference_source": "def solve(buckets):\n    result=[]\n    for bucket in buckets:\n        row=dict(bucket)\n        if \"percent_used\" in row:\n            row[\"percent\"]=row.pop(\"percent_used\")\n        result.append(row)\n    return result\n",
