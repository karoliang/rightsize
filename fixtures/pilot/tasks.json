      "id": "implementation-commitment-load",
      "tier": "implementation",
      "task": "Return [total points, count] for attempts whose state is admitted, launching, started, producing, cancelling or reconciling. Points are nonnegative integers. Terminal attempts do not count.",
      "initial_source": "def solve(attempts):\n    return [0,0]\n",
      "reference_source": "def solve(attempts):\n    active={\"admitted\",\"launching\",\"started\",\"producing\",\"cancelling\",\"reconciling\"}\n    held=[row for row in attempts if row[\"state\"] in active]\n    return [sum(row[\"points\"] for row in held),len(held)]\n",
