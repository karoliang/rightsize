# agent-route reads these from the environment, or from Infisical when this
# repo is linked with `infisical init`. Never commit real values.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Both OpenCode keys fall back to ~/.local/share/opencode/auth.json when unset.
OPENCODE_API_KEY=
OPENCODE_ZEN_API_KEY=
